rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Tracks images: public read, admin write
    match /tracks/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Submissions: owner-only write, owner + admin read
    match /submissions/{uid}/{assignmentId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/png', 'image/jpeg', 'image/webp',
          'application/pdf', 'text/plain',
          'text/x-python', 'text/x-dart', 'application/javascript'
        ];
      allow delete: if request.auth != null
        && (request.auth.uid == uid
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Fallback: deny all else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
